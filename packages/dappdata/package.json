{
  "name": "dappdata",
  "version": "0.0.0",
  "description": "Persistent, per-user dapp state on Swarm, keyed to the wallet the user already signed in with",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./envelope": {
      "types": "./dist/envelope/index.d.ts",
      "default": "./dist/envelope/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@ethersphere/bee-js": "13.0.0",
    "@ethersphere/core-sdk": "0.1.1",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@scure/bip39": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
